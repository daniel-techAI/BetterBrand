{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign fallback_images_csv = 'product-rebuild-hoodie-front-v3.jpg,product-rebuild-hoodie-detail-v3.jpg,product-rebuild-hoodie-back-v3.jpg'
  case product.handle
    when 'face-what-you-hide-hoodie'
      assign fallback_images_csv = 'product-face-hide-hoodie-front-v3.jpg,product-face-hide-hoodie-detail-v3.jpg,product-face-hide-hoodie-back-v3.jpg'
    when 'embrace-the-chaos-crop-tee'
      assign fallback_images_csv = 'product-embrace-tee-v1.jpg,product-embrace-tee-detail-v2.jpg,product-embrace-tee-flat-v2.jpg'
    when 'break-the-loop-heavy-tee'
      assign fallback_images_csv = 'product-break-loop-tee-front-v2.jpg,product-break-loop-tee-detail-v2.jpg,product-break-loop-tee-back-v2.jpg'
    when 'unavailable-edition-cap'
      assign fallback_images_csv = 'product-unavailable-cap-v2.jpg,product-unavailable-cap-detail-v2.jpg,product-unavailable-cap-back-v3.png'
    when 'prison-edition-cap'
      assign fallback_images_csv = 'product-prison-cap-v2.jpg,product-prison-cap-detail-v2.jpg,product-prison-cap-back-v3.png'
    when 'architecture-socks'
      assign fallback_images_csv = 'product-emotional-socks-v1.jpg,product-emotional-socks-detail-v2.jpg,product-emotional-socks-worn-v2.jpg'
    when 'emotional-sticker-set'
      assign fallback_images_csv = 'product-emotional-stickers-v2.jpg,product-emotional-stickers-detail-v2.jpg'
  endcase
  assign fallback_images = fallback_images_csv | split: ','
  assign fallback_image_count = fallback_images.size
%}

<section class="product-page commerce-page" data-product-root data-money-format="{{ shop.money_format | escape }}">
  <div class="product-gallery-shell" data-product-gallery aria-label="Product media">
    <div class="product-gallery" data-product-gallery-track>
      {% if product.media.size > 0 %}
        {% for media in product.media limit: 6 %}
          <div class="product-media {% if forloop.first %}is-featured is-active{% endif %}" data-product-slide data-media-id="{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt }}
              {% when 'video' %}
                {{ media | video_tag: controls: true, image_size: '1200x' }}
              {% when 'external_video' %}
                {{ media | external_video_tag }}
              {% when 'model' %}
                {{ media | model_viewer_tag }}
            {% endcase %}
          </div>
        {% endfor %}
      {% else %}
        {% for fallback_image in fallback_images %}
          <div class="product-media {% if forloop.first %}is-featured is-active{% endif %}" data-product-slide>
            <img src="{{ fallback_image | asset_url }}" alt="{{ product.title | default: 'R/CREATION product' | escape }} view {{ forloop.index }}" width="1024" height="1280">
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="product-gallery-nav" aria-label="Product image controls">
      <span data-gallery-counter>01 / {% if product.media.size > 0 %}{{ product.media.size | at_most: 6 | prepend: '0' | slice: -2, 2 }}{% else %}{{ fallback_image_count | prepend: '0' | slice: -2, 2 }}{% endif %}</span>
      <div>
        <button type="button" data-gallery-prev aria-label="Previous product image">{% render 'icon-chevron' %}</button>
        <button type="button" data-gallery-next aria-label="Next product image">{% render 'icon-chevron' %}</button>
      </div>
    </div>

    <div class="product-gallery-thumbnails" aria-label="Choose product image">
      {% if product.media.size > 0 %}
        {% for media in product.media limit: 6 %}
          <button type="button" data-gallery-target="{{ forloop.index0 }}" class="{% if forloop.first %}is-active{% endif %}" aria-label="View product image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>
            {% if media.preview_image %}{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
          </button>
        {% endfor %}
      {% else %}
        {% for fallback_image in fallback_images %}
          <button type="button" data-gallery-target="{{ forloop.index0 }}" class="{% if forloop.first %}is-active{% endif %}" aria-label="View product image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>
            <img src="{{ fallback_image | asset_url }}" alt="" width="1024" height="1280" loading="lazy">
          </button>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="product-info">
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      {% if product.collections.first %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span aria-hidden="true">/</span>
      {% endif %}
      <span>{{ product.title | default: 'Rebuild Yourself Crop Hoodie' }}</span>
    </nav>

    <span class="product-card-kicker">{{ product.type | default: 'Emotional Collection / Drop 001' }}</span>
    <h1>{{ product.title | default: 'Rebuild Yourself Crop Hoodie' }}</h1>
    <div class="product-price" data-product-price>
      <span>{{ current_variant.price | money | default: 'EUR 89.00' }}</span>
      {% if current_variant.compare_at_price > current_variant.price %}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {% endif %}
    </div>
    <p class="product-price-note">Taxes included where applicable. Shipping shown at checkout.</p>
    <div class="product-description">
      {% if product.description != blank %}
        {{ product.description }}
      {% else %}
        <p>A study in fracture and reconstruction. Heavy washed cotton carries the split classical figure, halo, serpent, and the instruction to rebuild yourself.</p>
      {% endif %}
    </div>

    {% form 'product', product, class: 'product-form', data-product-form: '' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          {% assign option_name = option.name | downcase %}
          {% assign is_color = false %}
          {% if option_name == 'color' or option_name == 'colour' %}{% assign is_color = true %}{% endif %}
          <fieldset class="variant-field {% if is_color %}is-color{% endif %}" data-option-position="{{ option.position }}">
            <legend>{{ option.name }} <span data-option-label>{{ option.selected_value }}</span></legend>
            <div class="variant-options">
              {% for value in option.values %}
                <label class="variant-option">
                  <input
                    type="radio"
                    name="options[{{ option.name | escape }}]"
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <span>
                    {% if is_color %}<i class="swatch swatch-{{ value | handleize }}" aria-hidden="true"></i>{% endif %}
                    <b>{{ value }}</b>
                  </span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      {% endunless %}

      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      <div class="quantity-row">
        <span>Quantity</span>
        <div class="quantity-stepper" data-quantity-stepper>
          <button type="button" data-quantity-minus aria-label="Decrease quantity">{% render 'icon-minus' %}</button>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" aria-label="Quantity">
          <button type="button" data-quantity-plus aria-label="Increase quantity">{% render 'icon-plus' %}</button>
        </div>
      </div>

      <p class="product-form-error" data-product-error role="alert" hidden></p>
      <button
        class="button button-primary product-submit"
        type="submit"
        data-add-to-cart
        data-available-label="Add to bag"
        data-sold-out-label="Sold out"
        {% unless current_variant.available %}disabled{% endunless %}
      >{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
      {{ form | payment_button }}
    {% endform %}

    <div class="product-accordions">
      <details>
        <summary><span>Details</span><span aria-hidden="true"></span></summary>
        <div>{{ section.settings.details_text }}</div>
      </details>
      <details>
        <summary><span>Fit & care</span><span aria-hidden="true"></span></summary>
        <div>{{ section.settings.care_text }}</div>
      </details>
      <details>
        <summary><span>Production</span><span aria-hidden="true"></span></summary>
        <div>{{ section.settings.production_text }}</div>
      </details>
      <details>
        <summary><span>Shipping & returns</span><span aria-hidden="true"></span></summary>
        <div>{{ section.settings.shipping_text }}</div>
      </details>
    </div>

    <p class="product-trust">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M7 10V8a5 5 0 0 1 10 0v2m-11 0h12v10H6V10Z" stroke="currentColor" stroke-width="1.4"/><path d="M12 14v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      Secure checkout <span aria-hidden="true">&middot;</span> Produced to order
    </p>
  </div>

  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "richtext",
      "id": "details_text",
      "label": "Details",
      "default": "<p>Heavy washed cotton, relaxed construction, front statement treatment, and a large back artwork drawn from the Emotional Collection.</p>"
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Fit and care",
      "default": "<p>Relaxed fit. Wash cold with similar colors and air dry to preserve the shape.</p>"
    },
    {
      "type": "richtext",
      "id": "production_text",
      "label": "Production",
      "default": "<p>Drop 001 is planned as a small, produced-to-order release to reduce waste and avoid excess inventory.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping and returns",
      "default": "<p>Shipping rates and delivery windows are calculated at checkout. Returns follow your store policy.</p>"
    }
  ]
}
{% endschema %}
