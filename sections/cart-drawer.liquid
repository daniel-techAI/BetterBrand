{% liquid
  assign threshold_cents = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  assign progress = 0
  if threshold_cents > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
  endif
  if progress > 100
    assign progress = 100
  endif
%}

<div class="cart-drawer-shell" data-cart-shell>
  <button class="drawer-overlay" type="button" aria-label="Close cart" data-cart-close tabindex="-1"></button>
  <aside
    id="CartDrawer"
    class="cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    aria-hidden="true"
    data-cart-drawer
  >
    <div class="drawer-heading">
      <div>
        <h2 id="CartDrawerTitle">Your bag</h2>
        <p class="cart-drawer-status" data-cart-status aria-live="polite"></p>
      </div>
      <button class="drawer-close" type="button" aria-label="Close cart" data-cart-close>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {% if threshold_cents > 0 %}
      <div class="shipping-progress">
        {% if remaining > 0 %}
          <p>{{ remaining | money }} away from complimentary shipping</p>
        {% else %}
          <p>Complimentary shipping unlocked</p>
        {% endif %}
        <span aria-hidden="true"><i style="--cart-progress: {{ progress }}%;"></i></span>
      </div>
    {% endif %}

    <div class="cart-drawer-body" data-cart-drawer-body>
      {% if cart.item_count > 0 %}
        <div class="cart-drawer-items">
          {% for item in cart.items %}
            <article class="drawer-item" data-cart-item data-line-key="{{ item.key }}">
              <a class="drawer-item-media" href="{{ item.url }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.product.title }}
                {% endif %}
              </a>
              <div class="drawer-item-details">
                <div>
                  <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {% unless item.product.has_only_default_variant %}
                    <p>{{ item.variant.title }}</p>
                  {% endunless %}
                  <p>{{ item.final_line_price | money }}</p>
                </div>
                <div class="quantity-stepper" data-quantity-stepper>
                  <button type="button" data-quantity-minus aria-label="Decrease {{ item.product.title | escape }} quantity">{% render 'icon-minus' %}</button>
                  <input type="number" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}" data-cart-quantity>
                  <button type="button" data-quantity-plus aria-label="Increase {{ item.product.title | escape }} quantity">{% render 'icon-plus' %}</button>
                </div>
                <button class="remove-button" type="button" data-cart-remove>Remove</button>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="drawer-empty">
          <p>Your bag is empty.</p>
          <a class="text-link" href="{{ routes.collections_url }}">Discover the collection {% render 'icon-arrow' %}</a>
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer-footer">
        <div class="drawer-subtotal">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p>Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="button button-primary" type="submit" name="checkout">Checkout</button>
        </form>
        <a class="drawer-view-link" href="{{ routes.cart_url }}">View bag</a>
      </div>
    {% endif %}
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 0,
      "max": 500,
      "step": 10,
      "default": 150
    }
  ]
}
{% endschema %}
