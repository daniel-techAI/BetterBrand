<footer class="site-footer">
  <div class="footer-statement">
    <p>{{ settings.tagline | default: 'You wear what you are.' }}</p>
    <strong>{{ settings.brand_name | default: 'R/CREATION' }}</strong>
  </div>
  <div class="footer-grid">
    <div>
      <a class="brand-mark footer-brand" href="{{ routes.root_url }}">{{ settings.brand_name | default: 'R/CREATION' }}</a>
      <p>An independent emotional design studio built in Slovakia. Apparel by R/CREATION. Theory beneath it by Hades.</p>
    </div>
    <div>
      <h2>Drop 001</h2>
      <a href="/collections/hoodies">Hoodies</a>
      <a href="/collections/tees">First layers</a>
      <a href="/collections/hats-caps">Headwear</a>
      <a href="/collections/accessories">Objects</a>
      <a href="/pages/lookbook">Editorial</a>
    </div>
    <div>
      <h2>Support</h2>
      <a href="/pages/about#founder">Founder</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/policies/shipping-policy">Shipping</a>
      <a href="/policies/refund-policy">Returns</a>
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
    </div>
    <div>
      <h2>Stay Close</h2>
      <p>Private drop notes, sample decisions, and release access.</p>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required>
        <button type="submit" aria-label="Subscribe">{% render 'icon-arrow' %}</button>
      {% endform %}
      <a class="footer-instagram" href="https://www.instagram.com/r_creationapparel/" target="_blank" rel="noreferrer">
        {% render 'icon-instagram' %}
        @r_creationapparel
      </a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Site footer",
  "settings": []
}
{% endschema %}
