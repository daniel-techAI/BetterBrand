{% assign category_titles = 'Hoodies,First Layers,Headwear,Socks,Objects' | split: ',' %}
{% assign category_handles = 'hoodies,tees,hats-caps,socks,accessories' | split: ',' %}
{% assign fallback_assets = 'product-rebuild-hoodie-v2.jpg,product-embrace-tee-v1.jpg,product-emotional-caps-v1.jpg,product-emotional-socks-v1.jpg,sticker-concepts-v1.jpg' | split: ',' %}

<section class="collections-page commerce-page">
  <header class="collections-intro">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.copy }}</p>
  </header>

  <div class="collections-index">
    {% for title in category_titles %}
      {% assign handle = category_handles[forloop.index0] %}
      {% assign category_collection = collections[handle] %}
      {% assign fallback_asset = fallback_assets[forloop.index0] %}
      <a class="collection-index-item" href="{% if category_collection != blank %}{{ category_collection.url }}{% else %}/collections/{{ handle }}{% endif %}">
        <span class="collection-index-number">0{{ forloop.index }}</span>
        <span class="collection-index-media">
          {% if category_collection.featured_image %}
            {{ category_collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: title }}
          {% else %}
            <img src="{{ fallback_asset | asset_url }}" alt="{{ title }} collection" width="1024" height="1280" loading="lazy">
          {% endif %}
        </span>
        <span class="collection-index-title">{{ title }}</span>
        <span class="collection-index-arrow">{% render 'icon-arrow' %}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections index",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Emotional Collection" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Five forms, one emotional system. Begin with the piece that says what you have been carrying." }
  ]
}
{% endschema %}
