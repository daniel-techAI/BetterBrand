<section class="hero-section">
  <div class="hero-copy">
    <h1>R/CREATION</h1>
    <p>You wear what you are.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="{{ routes.collections_url }}">Shop the Drop</a>
      <a class="button button-quiet" href="/pages/lookbook">Explore Lookbook</a>
    </div>
  </div>

  <div class="hero-stage" aria-label="Featured apparel">
    <div class="product-sculpture hoodie">
      <span>CORE HOODIE</span>
    </div>
    <div class="product-sculpture tee">
      <span>WEIGHT TEE</span>
    </div>
    <div class="product-sculpture cap">
      <span>R/CAP</span>
    </div>
    <div class="material-chip chip-one">Heavy cotton fleece</div>
    <div class="material-chip chip-two">Stone / Black / Bone</div>
  </div>
</section>

{% schema %}
{
  "name": "R/CREATION hero",
  "settings": [],
  "presets": [
    {
      "name": "R/CREATION hero"
    }
  ]
}
{% endschema %}

