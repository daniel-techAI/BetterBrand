<section class="emotion-hero" data-hero>
  <div class="emotion-hero-media" data-hero-media>
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: section.settings.image.alt }}
    {% else %}
      <img src="{{ 'emotional-hero-v1.jpg' | asset_url }}" alt="R/CREATION Emotional Collection campaign with two models in black graphic hoodies" width="1680" height="945" loading="eager" fetchpriority="high">
    {% endif %}
  </div>

  <div class="emotion-hero-copy">
    <p class="emotion-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>
      <span>{{ section.settings.heading_line_one }}</span>
      <span>{{ section.settings.heading_line_two }}</span>
    </h1>
    <p class="emotion-hero-intro">{{ section.settings.tagline }}</p>
    <div class="hero-actions">
      <a class="button button-gold" href="{{ section.settings.primary_link | default: '#drop-001' }}">
        {{ section.settings.primary_label }}
        {% render 'icon-arrow' %}
      </a>
      <a class="button button-quiet" href="{{ section.settings.secondary_link | default: '/pages/about' }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>

  <div class="emotion-hero-chapters" aria-hidden="true">
    <span>01 / Rebuild yourself</span>
    <span>02 / Face what you hide</span>
  </div>

  <div class="emotion-hero-meta" aria-hidden="true">
    <span>Drop 001</span>
    <span>Emotional Collection</span>
    <span>Designed in Slovakia</span>
  </div>
</section>

<div class="emotion-ticker" aria-label="Collection statements">
  <div>
    <span>Rebuild yourself</span>
    <span>Break the loop</span>
    <span>Face what you hide</span>
    <span>Nothing is permanent</span>
    <span aria-hidden="true">Rebuild yourself</span>
    <span aria-hidden="true">Break the loop</span>
  </div>
</div>

{% schema %}
{
  "name": "Emotional collection hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "R/CREATION x HADES THEORY"
    },
    {
      "type": "text",
      "id": "heading_line_one",
      "label": "Heading line one",
      "default": "Emotions are"
    },
    {
      "type": "text",
      "id": "heading_line_two",
      "label": "Heading line two",
      "default": "architecture."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Introduction",
      "default": "What you carry becomes what you create. The first collection turns private battles into visible form."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Enter Drop 001"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Read the theory"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Emotional collection hero"
    }
  ]
}
{% endschema %}
