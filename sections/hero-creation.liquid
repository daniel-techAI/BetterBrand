<section class="hero-section" data-hero>
  <div class="hero-media" data-hero-media>
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: section.settings.image.alt }}
    {% else %}
      <img src="{{ 'brand-hero-v2.png' | asset_url }}" alt="Black and bone R/CREATION apparel arranged on dark stone" width="1680" height="945" loading="eager" fetchpriority="high">
    {% endif %}
  </div>

  <div class="hero-copy">
    <h1>{{ section.settings.heading | default: settings.brand_name }}</h1>
    <p>{{ section.settings.tagline | default: settings.tagline }}</p>
    <div class="hero-actions">
      <a class="button button-gold" href="{{ section.settings.primary_link | default: routes.collections_url }}">
        {{ section.settings.primary_label }}
        {% render 'icon-arrow' %}
      </a>
      <a class="button button-quiet" href="{{ section.settings.secondary_link | default: '/pages/lookbook' }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>

  <div class="hero-meta" aria-hidden="true">
    <span>R/C 001</span>
    <span>Scroll to discover</span>
  </div>
</section>

{% schema %}
{
  "name": "R/CREATION hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "R/CREATION"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "You wear what you are."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Explore editorial"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "R/CREATION hero"
    }
  ]
}
{% endschema %}
