<section class="emotion-manifesto" id="drop-001" data-emotion-reveal>
  <div class="emotion-manifesto-heading">
    <p class="emotion-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="emotion-manifesto-copy">
    <p>{{ section.settings.copy }}</p>
    <a class="text-link" href="{{ section.settings.link | default: '/pages/about' }}">
      {{ section.settings.link_label }}
      {% render 'icon-arrow' %}
    </a>
  </div>

  <div class="emotion-manifesto-art">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 44vw, 100vw', alt: section.settings.image.alt }}
    {% else %}
      <img src="{{ 'art-emotional-duality-v1.jpg' | asset_url }}" alt="Split classical face with halo and serpent representing emotional duality" width="1280" height="853" loading="lazy">
    {% endif %}
  </div>

  <div class="emotion-manifesto-notes" aria-label="Collection themes">
    <span>Chaos / Growth</span>
    <span>Control / Freedom</span>
    <span>Vulnerability / Power</span>
    <span>Captivity / Release</span>
  </div>
</section>

{% schema %}
{
  "name": "Emotional manifesto",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "01 / The thesis"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you hide still shapes you."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "The Emotional Collection is built around contradiction: protection and exposure, discipline and chaos, the person you perform and the person underneath. These are not graphics added to clothes. They are private architecture made visible."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Manifesto image"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Inside Hades Theory"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Emotional manifesto"
    }
  ]
}
{% endschema %}
