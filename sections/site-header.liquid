{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    <span>{{ section.settings.shipping_text }}</span>
    <span>{{ section.settings.center_text }}</span>
    <span>{{ section.settings.market_text }}</span>
  </div>
{% endif %}

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand-mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <span>{{ settings.brand_name | default: 'R/CREATION' }}</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <a href="{{ routes.collections_url }}">Shop</a>
      <a href="/collections/tees">Tees</a>
      <a href="/collections/hoodies">Hoodies</a>
      <a href="/collections/pants">Pants</a>
      <a href="/collections/shorts">Shorts</a>
      <a href="/collections/hats-caps">Hats & Caps</a>
      <a href="/pages/lookbook">Editorial</a>
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'icon-bag' %}
        <span>Cart</span>
        {% if cart.item_count > 0 %}
          <b>{{ cart.item_count }}</b>
        {% endif %}
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    <a href="{{ routes.collections_url }}">Shop</a>
    <a href="/collections/hoodies">Hoodies</a>
    <a href="/collections/tees">Tees</a>
    <a href="/collections/pants">Pants</a>
    <a href="/collections/hats-caps">Hats & Caps</a>
    <a href="/pages/lookbook">Lookbook</a>
    <a href="/pages/about">About</a>
  </div>
</header>

{% schema %}
{
  "name": "Site header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Left announcement",
      "default": "Worldwide shipping"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center announcement",
      "default": "Built different. Made to last."
    },
    {
      "type": "text",
      "id": "market_text",
      "label": "Right announcement",
      "default": "EN / EUR"
    }
  ]
}
{% endschema %}
