{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    <span>{{ section.settings.shipping_text }}</span>
    <span>{{ section.settings.center_text }}</span>
    <span>{{ section.settings.market_text }}</span>
  </div>
{% endif %}

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand-mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <span>{{ settings.brand_name | default: 'R/CREATION' }}</span>
    </a>

    {% assign has_about_link = false %}
    <nav class="main-nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.type == 'page_link' and link.object.handle == 'about' %}{% assign has_about_link = true %}{% endif %}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
        {% unless has_about_link %}<a href="{{ routes.root_url }}pages/about">About</a>{% endunless %}
      {% else %}
        <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}">Shop</a>
        <a href="{{ routes.root_url }}#collection">Drop 001</a>
        <a href="{{ routes.collections_url }}/women">Women</a>
        <a href="{{ routes.collections_url }}/men">Men</a>
        <a href="{{ routes.collections_url }}/accessories">Objects</a>
        <a href="{{ routes.root_url }}pages/about#hades">Theory</a>
        <a href="{{ routes.root_url }}pages/about">About</a>
      {% endif %}
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="{{ routes.search_url }}" aria-label="Search" data-catalog-open="search" aria-controls="CatalogDrawer" aria-expanded="false">
        {% render 'icon-search' %}
      </a>
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Open cart" aria-controls="CartDrawer" data-cart-open>
        {% render 'icon-bag' %}
        <span>Cart</span>
        <b data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</b>
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav aria-hidden="true">
    <button class="catalog-drawer-overlay" type="button" data-menu-close aria-label="Close navigation"></button>
    <aside id="CatalogDrawer" class="catalog-drawer" role="dialog" aria-modal="true" aria-label="Shop navigation">
      <div class="catalog-drawer-heading">
        <span>R/CREATION / Catalog</span>
        <button class="catalog-close" type="button" data-menu-close aria-label="Close navigation">{% render 'icon-close' %}</button>
      </div>

      <form class="catalog-search" action="{{ routes.search_url }}" method="get" role="search">
        {% render 'icon-search' %}
        <label class="visually-hidden" for="CatalogSearch-{{ section.id }}">Search the collection</label>
        <input id="CatalogSearch-{{ section.id }}" type="search" name="q" placeholder="Search pieces" data-catalog-search>
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Submit search">{% render 'icon-arrow' %}</button>
      </form>

      <a class="catalog-profile" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        <span class="catalog-profile-icon">{% render 'icon-user' %}</span>
        <span>
          <strong>{% if customer %}Your account{% else %}Sign in{% endif %}</strong>
          <small>{% if customer %}Orders, addresses, and profile{% else %}Account access and order history{% endif %}</small>
        </span>
        {% render 'icon-chevron' %}
      </a>

      <nav class="catalog-primary-nav" aria-label="Shop departments">
        <a href="{{ routes.collections_url }}/women"><span>Women</span><small>Reconstruction</small>{% render 'icon-chevron' %}</a>
        <a href="{{ routes.collections_url }}/men"><span>Men</span><small>Confrontation</small>{% render 'icon-chevron' %}</a>
        <a href="{{ routes.collections_url }}/drop-001"><span>Drop 001</span><small>View every piece</small>{% render 'icon-chevron' %}</a>
      </nav>

      <nav class="catalog-category-nav" aria-label="Shop categories">
        <a href="{{ routes.collections_url }}/hoodies">Hoodies</a>
        <a href="{{ routes.collections_url }}/tees">Tees</a>
        <a href="{{ routes.collections_url }}/hats-caps">Headwear</a>
        <a href="{{ routes.collections_url }}/accessories">Objects</a>
      </nav>

      <div class="catalog-drawer-footer">
        <a href="{{ routes.root_url }}pages/lookbook">Editorial</a>
        <a href="{{ routes.root_url }}pages/about">Founder story</a>
        <a href="https://www.instagram.com/r_creationapparel/" target="_blank" rel="noopener">Instagram</a>
        <p>Independent studio / Slovakia</p>
      </div>
    </aside>
  </div>
</header>

{% schema %}
{
  "name": "Site header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Left announcement",
      "default": "Designed in Slovakia"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center announcement",
      "default": "Drop 001 / Emotional Collection"
    },
    {
      "type": "text",
      "id": "market_text",
      "label": "Right announcement",
      "default": "EU launch / EUR"
    }
  ]
}
{% endschema %}
