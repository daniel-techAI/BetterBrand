<section class="featured-products emotional-featured section-light" id="collection">
  <div class="section-heading compact">
    <div>
      <span class="section-index">03 / Drop 001</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <a class="text-link" href="{{ routes.collections_url }}">View the full collection {% render 'icon-arrow' %}</a>
  </div>

  <div class="product-grid">
    {% assign chosen_collection = section.settings.collection | default: collections.all %}
    {% if chosen_collection.products_count > 0 %}
      {% for product in chosen_collection.products limit: 4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% render 'product-card-placeholder', title: 'Rebuild Yourself Crop Hoodie', price: 'EUR 89.00', image_asset: 'product-rebuild-hoodie-v1.jpg', secondary_asset: 'editorial-emotional-system-v1.jpg', colors: 'black,deep-heather,mauve', eyebrow: 'Women / Reconstruction', badge: 'Drop 001', url: '/collections/hoodies' %}
      {% render 'product-card-placeholder', title: 'Face What You Hide Hoodie', price: 'EUR 94.00', image_asset: 'product-face-hide-hoodie-v1.jpg', secondary_asset: 'editorial-emotional-lineup-v1.jpg', colors: 'black,charcoal,bone', eyebrow: 'Men / Confrontation', badge: 'Drop 001', url: '/collections/hoodies' %}
      {% render 'product-card-placeholder', title: 'Embrace The Chaos Crop Tee', price: 'EUR 42.00', image_asset: 'product-embrace-tee-v1.jpg', secondary_asset: 'art-emotional-architecture-v1.jpg', colors: 'black,bone,dusty-rose', eyebrow: 'Women / First layer', badge: 'Concept', url: '/collections/tees' %}
      {% render 'product-card-placeholder', title: 'Architecture Socks', price: 'EUR 22.00', image_asset: 'product-emotional-socks-v1.jpg', secondary_asset: 'art-emotional-duality-v1.jpg', colors: 'black,bone', eyebrow: 'Objects / Everyday', badge: 'New concept', url: '/collections/socks' %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Emotional Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
