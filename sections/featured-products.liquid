<section class="featured-products section-light">
  <div class="section-heading compact">
    <div>
      <span class="section-index">02 / New release</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <a class="text-link" href="{{ routes.collections_url }}">View all {% render 'icon-arrow' %}</a>
  </div>

  <div class="product-grid">
    {% assign chosen_collection = section.settings.collection | default: collections.all %}
    {% if chosen_collection.products_count > 0 %}
      {% for product in chosen_collection.products limit: 4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% render 'product-card-placeholder', title: 'Core Hoodie', price: 'EUR 119.00', image_asset: 'product-core-hoodie-v2.png', colors: 'black,bone,stone' %}
      {% render 'product-card-placeholder', title: 'Weight Tee', price: 'EUR 59.00', image_asset: 'product-weight-tee-v2.png', colors: 'bone,black,stone' %}
      {% render 'product-card-placeholder', title: 'Intent Pant', price: 'EUR 94.00', image_asset: 'product-intent-pant-v2.png', colors: 'black,charcoal,stone' %}
      {% render 'product-card-placeholder', title: 'R/ Cap', price: 'EUR 39.00', image_asset: 'product-rc-cap-v2.png', colors: 'stone,black,brown' %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The first drop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
