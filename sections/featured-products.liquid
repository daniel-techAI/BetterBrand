<section class="featured-products emotional-featured section-light" id="collection">
  <div class="section-heading compact">
    <div>
      <span class="section-index">03 / Drop 001</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <a class="text-link" href="{{ routes.collections_url }}">View the full collection {% render 'icon-arrow' %}</a>
  </div>

  <div class="product-grid">
    {% assign chosen_collection = section.settings.collection | default: collections.all %}
    {% if chosen_collection.products_count > 0 %}
      {% for product in chosen_collection.products limit: 4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% render 'product-card-placeholder', handle: 'rebuild-yourself-crop-hoodie', title: 'Rebuild Yourself Crop Hoodie', price: 'EUR 84.00', image_asset: 'product-rebuild-hoodie-front-v3.jpg', secondary_asset: 'product-rebuild-hoodie-detail-v3.jpg', colors: 'black,deep-heather,mauve', eyebrow: 'Women / Reconstruction', badge: 'Drop 001' %}
      {% render 'product-card-placeholder', handle: 'face-what-you-hide-hoodie', title: 'Face What You Hide Hoodie', price: 'EUR 89.00', image_asset: 'product-face-hide-hoodie-front-v3.jpg', secondary_asset: 'product-face-hide-hoodie-detail-v3.jpg', colors: 'black,charcoal,bone', eyebrow: 'Men / Confrontation', badge: 'Drop 001' %}
      {% render 'product-card-placeholder', handle: 'embrace-the-chaos-crop-tee', title: 'Embrace The Chaos Crop Tee', price: 'EUR 42.00', image_asset: 'product-embrace-tee-v1.jpg', secondary_asset: 'product-embrace-tee-detail-v2.jpg', colors: 'black,bone,dusty-rose', eyebrow: 'Women / First layer', badge: 'Concept' %}
      {% render 'product-card-placeholder', handle: 'break-the-loop-heavy-tee', title: 'Break The Loop Heavy Tee', price: 'EUR 46.00', image_asset: 'product-break-loop-tee-front-v2.jpg', secondary_asset: 'product-break-loop-tee-detail-v2.jpg', colors: 'washed-black,charcoal', eyebrow: 'Men / Confrontation', badge: 'New concept' %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Emotional Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
