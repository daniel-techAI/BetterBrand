<section class="collection-strip">
  <div class="section-heading">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.copy }}</p>
  </div>

  <div class="category-rail">
    {% assign categories = "Tees,Hoodies,Pants,Shorts,Socks,Hats & Caps" | split: "," %}
    {% for category in categories %}
      <a class="category-tile" href="/collections/{{ category | handleize }}">
        <span>{{ category }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The first layer of intention"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Quiet cuts, heavy fabric, and neutral tones made to move between seasons."
    }
  ],
  "presets": [
    {
      "name": "Collection strip"
    }
  ]
}
{% endschema %}

