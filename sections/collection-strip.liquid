<section class="collection-strip emotion-form-index section-light" id="shop">
  <div class="section-heading">
    <div>
      <span class="section-index">05 / Shop by form</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <p>{{ section.settings.copy }}</p>
  </div>

  <div class="category-rail emotion-category-rail">
    {% assign category_titles = "Hoodies,Tees,Headwear,Objects" | split: "," %}
    {% assign category_handles = "hoodies,tees,hats-caps,accessories" | split: "," %}
    {% assign fallback_assets = "product-rebuild-hoodie-front-v3.jpg,product-embrace-tee-v1.jpg,product-unavailable-cap-v2.jpg,product-emotional-socks-worn-v2.jpg" | split: "," %}

    {% for category in category_titles %}
      {% assign category_handle = category_handles[forloop.index0] %}
      {% assign fallback_asset = fallback_assets[forloop.index0] %}
      {% case forloop.index %}
        {% when 1 %}
          {% assign category_image = section.settings.hoodies_image %}
          {% assign category_note = 'Two chapters' %}
        {% when 2 %}
          {% assign category_image = section.settings.tees_image %}
          {% assign category_note = 'First layer' %}
        {% when 3 %}
          {% assign category_image = section.settings.caps_image %}
          {% assign category_note = 'Quiet statements' %}
        {% else %}
          {% assign category_image = section.settings.objects_image %}
          {% assign category_note = 'Socks + editions' %}
      {% endcase %}

      <a class="category-tile" href="/collections/{{ category_handle }}">
        <span class="category-media">
          {% if category_image %}
            {{ category_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 25vw, 76vw', alt: category }}
          {% else %}
            <img src="{{ fallback_asset | asset_url }}" alt="{{ category }} from the Emotional Collection" width="1024" height="1280" loading="lazy">
          {% endif %}
        </span>
        <span class="category-label">
          <span><small>{{ category_note }}</small><b>{{ category }}</b></span>
          {% render 'icon-arrow' %}
        </span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection forms",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose what carries the message."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "The collection begins with four forms: heavyweight layers, first layers, washed headwear, and smaller objects built from the same emotional language."
    },
    {
      "type": "image_picker",
      "id": "hoodies_image",
      "label": "Hoodies image"
    },
    {
      "type": "image_picker",
      "id": "tees_image",
      "label": "Tees image"
    },
    {
      "type": "image_picker",
      "id": "caps_image",
      "label": "Headwear image"
    },
    {
      "type": "image_picker",
      "id": "objects_image",
      "label": "Objects image"
    }
  ],
  "presets": [
    {
      "name": "Collection forms"
    }
  ]
}
{% endschema %}
