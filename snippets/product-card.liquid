<article class="product-card">
  <a href="{{ product.url }}" class="product-card-media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', class: 'product-card-primary-image' }}
      {% assign card_hover_image = product.metafields.custom.card_hover_image.value %}
      {% if card_hover_image != blank %}
        {{ card_hover_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', class: 'product-card-secondary-image' }}
      {% endif %}
    {% else %}
      <img src="{{ 'product-rebuild-hoodie-front-v3.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="1024" height="1536" loading="lazy">
    {% endif %}
    <span class="product-card-action" aria-hidden="true">{% render 'icon-arrow' %}</span>
  </a>
  <div class="product-card-info">
    <div>
      {% if product.type != blank %}<span class="product-card-kicker">{{ product.type }}</span>{% endif %}
      <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
      <p>{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p>
      {% for option in product.options_with_values %}
        {% assign option_name = option.name | downcase %}
        {% if option_name == 'color' or option_name == 'colour' %}
          <div class="product-card-swatches" aria-label="Available colors">
            {% for value in option.values limit: 4 %}
              <span class="swatch swatch-{{ value | handleize }}" title="{{ value | escape }}"></span>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</article>
