<div class="concept-viewer" data-concept-viewer aria-hidden="true">
  <button class="concept-viewer-overlay" type="button" data-concept-close aria-label="Close product preview"></button>
  <section class="concept-viewer-panel" role="dialog" aria-modal="true" aria-labelledby="ConceptProductTitle" tabindex="-1">
    <header class="concept-viewer-header">
      <span>R/CREATION / Drop 001</span>
      <span data-concept-position>Product study</span>
      <button type="button" data-concept-close aria-label="Close product preview">{% render 'icon-close' %}</button>
    </header>

    <div class="concept-viewer-layout">
      <div class="concept-viewer-gallery" data-concept-gallery>
        <div class="concept-viewer-track" data-concept-track></div>
        <div class="concept-viewer-gallery-controls">
          <span data-concept-counter>01 / 03</span>
          <div>
            <button type="button" data-concept-prev aria-label="Previous product image">{% render 'icon-chevron' %}</button>
            <button type="button" data-concept-next aria-label="Next product image">{% render 'icon-chevron' %}</button>
          </div>
        </div>
        <div class="concept-viewer-thumbnails" data-concept-thumbnails aria-label="Choose product image"></div>
      </div>

      <div class="concept-viewer-info">
        <div class="concept-viewer-heading">
          <span class="product-card-kicker" data-concept-eyebrow></span>
          <h2 id="ConceptProductTitle" data-concept-title></h2>
          <p class="concept-viewer-price" data-concept-price></p>
        </div>
        <p class="concept-viewer-description" data-concept-description></p>

        <div class="concept-viewer-options">
          <fieldset>
            <legend>Color <span data-concept-color-label></span></legend>
            <div data-concept-colors></div>
          </fieldset>
          <fieldset>
            <legend>Size <span data-concept-size-label></span></legend>
            <div data-concept-sizes></div>
          </fieldset>
        </div>

        <div class="concept-viewer-notes">
          <details open>
            <summary><span>The design</span><span aria-hidden="true"></span></summary>
            <p data-concept-story></p>
          </details>
          <details>
            <summary><span>Fit and production</span><span aria-hidden="true"></span></summary>
            <p data-concept-fit></p>
          </details>
        </div>

        <div class="concept-viewer-status">
          <span>Concept preview / sample pending</span>
          <p>This piece becomes purchasable after the physical sample, print, and fit pass inspection.</p>
          <a class="button button-ink" href="{{ routes.root_url }}#access">Join private access {% render 'icon-arrow' %}</a>
        </div>
      </div>
    </div>
  </section>
</div>

